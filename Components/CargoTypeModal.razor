@using MudBlazor

<MudDialog @bind-IsVisible="IsOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h4" Class="font-bold dark:text-white">نوع بار</MudText>
        <MudText Typo="Typo.subtitle1" Class="pt-3 text-n400">نوع بار خود را انتخاب کنید</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4" Class="border-y border-dashed border-n100 py-5 dark:border-n70">
            @foreach (var cargo in CargoTypes)
            {
                <MudPaper Elevation="0" Class="cursor-pointer" @onclick="() => SelectCargo(cargo.Name)">
                    <MudGrid Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudItem>
                            <MudStack Row="true" Spacing="3">
                                <MudPaper Elevation="0" Class="rounded-full bg-white p-2.5 dark:bg-n0">
                                    <MudIcon Icon="@cargo.Icon" Color="Color.Primary" Size="Size.Large" />
                                </MudPaper>
                                <div class="text-right">
                                    <MudText Typo="Typo.subtitle2" Class="font-semibold dark:text-white">@cargo.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="text-n400">@cargo.Description</MudText>
                                </div>
                            </MudStack>
                        </MudItem>
                        <MudItem>
                            <MudRadioGroup @bind-SelectedOption="selectedCargo">
                                <MudRadio Option="@cargo.Name" Color="Color.Primary" />
                            </MudRadioGroup>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton FullWidth="true" Variant="Variant.Outlined" OnClick="OnClose" Class="rounded-xl">لغو</MudButton>
        <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="OnConfirm" Class="rounded-xl">تایید</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnCargoTypeSelected { get; set; }

    private string selectedCargo;

    private DialogOptions dialogOptions = new()
    {
        FullWidth = true,
        CloseButton = false,
        DisableBackdropClick = true,
        NoHeader = false,
        ClassBackground = "bg-b50 dark:bg-n50"
    };

    private class CargoType
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public string Icon { get; set; }
    }

    private List<CargoType> CargoTypes = new()
    {
        new() { Id = "general", Name = "بار عمومی", Description = "کالاهای معمولی و عمومی", Icon = "fas fa-box" },
        new() { Id = "perishable", Name = "بار فاسدشدنی", Description = "مواد غذایی و فاسدشدنی", Icon = "fas fa-snowflake" },
        new() { Id = "dangerous", Name = "بار خطرناک", Description = "مواد شیمیایی و خطرناک", Icon = "fas fa-exclamation-triangle" },
        new() { Id = "heavy", Name = "بار سنگین", Description = "تجهیزات و ماشین‌آلات سنگین", Icon = "fas fa-truck" },
        new() { Id = "fragile", Name = "بار شکستنی", Description = "کالاهای شکستنی و حساس", Icon = "fas fa-wine-glass" }
    };

    private void SelectCargo(string cargo)
    {
        selectedCargo = cargo;
    }

    private async Task OnClose()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnConfirm()
    {
        if (!string.IsNullOrEmpty(selectedCargo))
        {
            await OnCargoTypeSelected.InvokeAsync(selectedCargo);
        }
        await OnClose();
    }
} 