@using MudBlazor
@using mobilebenyamin.Components.Support

<link href="css/components/HomePage/Navigation.css" rel="stylesheet" />

<div class="navigation-container">
    <div class="navigation-wrapper">
        <div class="navigation-inner">
            <div  style="cursor: pointer;">
                <div class="navigation-menu-bg" @onclick="OpenChatDialog">
                    <MudImage Src="assets/images/menu-bg.png" Alt="" Class="navigation-menu-bg-image" />
                    <div class="navigation-menu-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Medium" Class="!text-lg" />
                    </div>
                </div>
                <div class="navigation-link">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Medium" Class="text-white" />
                    <span class="navigation-dot"></span>
                </div>
            </div>
            <MudLink Href="/index" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Medium" Class="text-white" />
            </MudLink>
            <div @onclick="OpenChatDialog" class="navigation-support" style="cursor: pointer;"> 
                <MudText Class="text-white">پشتیبانی</MudText>
            </div>
            <MudLink Href="/index" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Wallet" Size="Size.Medium" Class="text-white" />
            </MudLink>
            <MudLink Href="/index" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Class="text-white" />
            </MudLink>
        </div>
    </div>
</div>

@code {
    [Inject]
    private IDialogService DialogService { get; set; }

    private async Task OpenChatDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true,
            Position = DialogPosition.Center,
            FullWidth = true,
            CloseButton = false,
            NoHeader = true,
            DisableBackdropClick = false,
            MaxWidth = MaxWidth.ExtraLarge
        };
        
        var dialog = await DialogService.ShowAsync<SupportChatDialog>("", parameters, options);
    }
} 