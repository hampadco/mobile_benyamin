@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudPaper Elevation="0" Class="hotelTab mt-7 rounded-3xl p-5 gap-0">
    <MudStack Spacing="0">
        <MudStack AlignItems="AlignItems.Center" Spacing="0" Class="border-b border-dashed border-n100 dark:border-n70">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body1" Color="Color.Primary" Class="font-bold">جستجوی بارها</MudText>
                <lord-icon
                    src="https://cdn.lordicon.com/msoeawqm.json"
                    trigger="hover"
                    colors="primary:#2563eb"
                    style="width:28px;height:28px">
                </lord-icon>
            </MudStack>
        </MudStack>

        <MudStack Spacing="0" Class="mt-0">
            <div class="animationOne content" id="flight">
                <MudStack Spacing="0">
                    <MudPaper Elevation="0" Class="w-full mb-0">
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Class="!rounded-md p-3.5">
                            <MudText Class="text-n400">انتخاب مبدا</MudText>
                        </MudButton>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="w-full mb-0">
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Class="!rounded-md p-3.5">
                            <MudText Class="text-n400">انتخاب مقصد</MudText>
                        </MudButton>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="w-full mb-0">
                        <MudText Class="pb-2" Typo="Typo.subtitle2">تاریخ حمل</MudText>
                        <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenDateModal" Class="!rounded-md p-3.5">
                            <MudText Class="text-n400">انتخاب تاریخ</MudText>
                        </MudButton>
                    </MudPaper>

                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudText Class="pb-2" Typo="Typo.subtitle2">نوع خودرو</MudText>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Class="!rounded-md p-3.5">
                                <MudText Class="text-n400">نوع خودرو</MudText>
                            </MudButton>
                        </MudItem>

                        <MudItem xs="6">
                            <MudText Class="pb-2" Typo="Typo.subtitle2">نوع بار</MudText>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenCargoTypeModal" Class="!rounded-md p-3.5">
                                <MudText Class="text-n400">انتخاب نوع بار</MudText>
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="!rounded-md p-3">
                        جستجوی بار
                    </MudButton>
                </MudStack>
            </div>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private bool isDateModalOpen;
    private bool isCargoTypeModalOpen;

    private void OpenDateModal()
    {
        isDateModalOpen = true;
    }

    private void OpenCargoTypeModal()
    {
        isCargoTypeModalOpen = true;
    }
} 