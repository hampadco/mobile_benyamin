@using MudBlazor
@using mobile_benyamin.Models
@inject IJSRuntime JSRuntime

<link href="css/components/HomePage/HomeTab.css" rel="stylesheet" />

<MudContainer MaxWidth="MaxWidth.False" Class="homeTab">
    <MudGrid Class="tab-button" Spacing="0" Justify="Justify.SpaceBetween">
        @foreach (var tab in _tabs)
        {
            <MudItem xs="4">
                <div class="px-1">
                    <MudPaper Elevation="2" Class="home-tab-item shadow-md transition-shadow hover:shadow-lg" @onclick="() => SelectTab(tab.Id)" >
                        <div class="absolute bottom-0 left-0 right-0 flex items-center justify-center">
                            <div class="activeBar @(ActiveTab == tab.Id ? "active" : "inactive")"></div>
                        </div>
                        <MudPaper Elevation="0" Class="b flex w-full items-center justify-center rounded-3xl bg-b50 py-3 dark:bg-n50">
                            <div class="service-icon">
                                <lord-icon
                                    src="@tab.IconUrl"
                                    trigger="hover"
                                    colors="primary:#2563eb"
                                    state="hover">
                                </lord-icon>
                            </div>
                        </MudPaper>
                        <div class="home-tab-content">
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="home-tab-title">@tab.Title</MudText>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="home-tab-subtitle">@tab.Subtitle</MudText>
                        </div>
                    </MudPaper>
                </div>
            </MudItem>
        }
    </MudGrid>

    <div id="reserve-section">
        @if (ActiveTab == "reserve")
        {
            <div class="animationOne content">
                <SearchCargo OnSearchRequested="HandleSearchRequested" />
            </div>
        }
    </div>

    <div id="new-cargo-section">
        @if (ActiveTab == "new-cargo")
        {
            <MudStack Class="pt-2" Spacing="3">
                <div class="animationOne content">
                    <NewCargoAuth />
                </div>
            </MudStack>
        }
    </div>

    <div id="waybill-section">
        @if (ActiveTab == "waybill")
        {
            <MudStack Class="pt-2" Spacing="3">
                <div class="animationOne content">
                    <WaybillAuth />
                </div>
            </MudStack>
        }
    </div>
</MudContainer>

@code {
    private string ActiveTab = "reserve";

    private List<TabItem> _tabs = new()
    {
        new TabItem 
        { 
            Id = "new-cargo",
            Title = "ثبت بار ",
            Subtitle = "اعلان بار",
            IconUrl = "https://cdn.lordicon.com/udwhdpod.json"
        },
        new TabItem 
        { 
            Id = "reserve",
            Title = "رزرو بار",
            Subtitle = "بازارگاه بار",
            IconUrl = "https://cdn.lordicon.com/qhviklyi.json"
        },
        new TabItem 
        { 
            Id = "waybill",
            Title = "بارنامه",
            Subtitle = " حواله بار",
            IconUrl = "https://cdn.lordicon.com/puvaffet.json"
        }
    };

    private async Task SelectTab(string tabId)
    {
        ActiveTab = tabId;
        StateHasChanged();
        await Task.Delay(100);
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToElement", $"{tabId}-section");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling to element: {ex.Message}");
        }
    }

    private async Task HandleSearchRequested(SearchCargoRequest request)
    {
        // اینجا می‌توانید جستجوی بار را پیاده‌سازی کنید
        Console.WriteLine($"Search requested: Origin={request.Origin}, Destination={request.Destination}, Date={request.Date}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("addSmoothScroll");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing smooth scroll: {ex.Message}");
            }
        }
    }

    private class TabItem
    {
        public string Id { get; set; }
        public string Title { get; set; }
        public string Subtitle { get; set; }
        public string IconUrl { get; set; }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; }
} 