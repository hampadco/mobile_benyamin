@using MudBlazor

<link href="css/components/HomePage/HomeTab.css" rel="stylesheet" />

<MudContainer MaxWidth="MaxWidth.False" Class="homeTab">
    <MudGrid Class="tab-button" Spacing="0" Justify="Justify.SpaceBetween">
        @foreach (var tab in _tabs)
        {
            <MudItem xs="4">
                <div class="px-1">
                    <MudPaper Elevation="2" Class="home-tab-item shadow-md transition-shadow hover:shadow-lg" @onclick="() => SelectTab(tab.Id)">
                        <div class="absolute bottom-0 left-0 right-0 flex items-center justify-center">
                            <div class="activeBar @(ActiveTab == tab.Id ? "active" : "inactive")"></div>
                        </div>
                        <MudPaper Elevation="0" Class="b flex w-full items-center justify-center rounded-3xl bg-b50 py-3 dark:bg-n50">
                            <div class="service-icon">
                                <lord-icon
                                    src="@tab.IconUrl"
                                    trigger="hover"
                                    colors="primary:#2563eb"
                                    state="hover">
                                </lord-icon>
                            </div>
                        </MudPaper>
                        <div class="home-tab-content">
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="home-tab-title">@tab.Title</MudText>
                            <MudText Typo="Typo.caption" Align="Align.Center" Class="home-tab-subtitle">@tab.Subtitle</MudText>
                        </div>
                    </MudPaper>
                </div>
            </MudItem>
        }
    </MudGrid>

    @if (ActiveTab == "reserve")
    {
        <MudPaper Elevation="2" Class="hotelTab mt-7 rounded-2xl p-4 shadow-md">
            <MudStack Spacing="3">
                <MudStack AlignItems="AlignItems.Center" Class="pb-3 border-b border-dashed border-n100 dark:border-n70">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="text-lg md:text-xl">جستجوی بارها</MudText>
                            <lord-icon
                                src="https://cdn.lordicon.com/msoeawqm.json"
                                trigger="hover"
                                colors="primary:#2563eb"
                                style="width:24px;height:24px">
                            </lord-icon>
                        </MudStack>
                    </MudStack>
                </MudStack>

                <MudStack Class="pt-2" Spacing="2">
                    <div class="animationOne content" id="flight">
                        <MudStack Spacing="2">
                            <MudPaper Elevation="0" Class="w-full">
                                <MudButton Variant="Variant.Outlined" FullWidth="true" Class="rounded-xl py-2.5 px-3">
                                    <MudText Class="text-n400 text-sm md:text-base">انتخاب مبدا</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudPaper Elevation="0" Class="w-full">
                                <MudButton Variant="Variant.Outlined" FullWidth="true" Class="rounded-xl py-2.5 px-3">
                                    <MudText Class="text-n400 text-sm md:text-base">انتخاب مقصد</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudPaper Elevation="0" Class="w-full">
                                <MudText Class="pb-1 text-sm md:text-base" Typo="Typo.subtitle2">تاریخ حمل</MudText>
                                <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenDateModal" Class="rounded-xl py-2.5 px-3">
                                    <MudText Class="text-n500 text-base md:text-xl lg:text-2xl">@SelectedDate</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudText Class="pb-1 text-sm md:text-base" Typo="Typo.subtitle2">نوع خودرو</MudText>
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenVehicleModal" Class="rounded-xl py-2.5 px-3">
                                        <MudText Class="text-n400 text-sm md:text-base">@SelectedVehicle</MudText>
                                    </MudButton>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudText Class="pb-1 text-sm md:text-base" Typo="Typo.subtitle2">نوع بار</MudText>
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenCargoTypeModal" Class="rounded-xl py-2.5 px-3">
                                        <MudText Class="text-n400 text-sm md:text-base">@SelectedCargoType</MudText>
                                    </MudButton>
                                </MudItem>
                            </MudGrid>

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SearchCargo" Class="rounded-xl py-3 mt-1">
                                <MudText Class="text-base md:text-lg font-medium">جستجوی بار</MudText>
                            </MudButton>
                        </MudStack>
                    </div>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else if (ActiveTab == "new-cargo")
    {
        <MudPaper Elevation="2" Class="hotelTab mt-7 rounded-2xl p-4 shadow-md">
            <MudStack Spacing="3">
                <MudStack AlignItems="AlignItems.Center" Class="pb-3 border-b border-dashed border-n100 dark:border-n70">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="text-lg md:text-xl">ثبت بار جدید</MudText>
                        <MudImage Src="assets/images/sadi/1.png" Alt="ثبت بار" Width="24" Height="24" ObjectFit="ObjectFit.Contain" />
                    </MudStack>
                </MudStack>

                <MudStack Class="pt-2" Spacing="3">
                    <div class="animationOne content">
                        <MudImage Src="assets/images/sadi/1.png" Alt="ثبت بار" Class="w-full h-auto rounded-xl" ObjectFit="ObjectFit.Contain" Style="max-height: 300px; width: 100%;" />
                    </div>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else if (ActiveTab == "waybill")
    {
        <MudPaper Elevation="2" Class="hotelTab mt-7 rounded-2xl p-4 shadow-md">
            <MudStack Spacing="3">
                <MudStack AlignItems="AlignItems.Center" Class="pb-3 border-b border-dashed border-n100 dark:border-n70">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="text-lg md:text-xl">بارنامه</MudText>
                        <MudImage Src="assets/images/sadi/2.png" Alt="بارنامه" Width="24" Height="24" ObjectFit="ObjectFit.Contain" />
                    </MudStack>
                </MudStack>

                <MudStack Class="pt-2" Spacing="3">
                    <div class="animationOne content">
                        <MudImage Src="assets/images/sadi/2.png" Alt="بارنامه" Class="w-full h-auto rounded-xl" ObjectFit="ObjectFit.Contain" Style="max-height: 300px; width: 100%;" />
                    </div>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

<DateModal @bind-IsOpen="isDateModalOpen" OnDateSelected="HandleDateSelected" />
<VehicleModal @bind-IsOpen="isVehicleModalOpen" OnVehicleSelected="HandleVehicleSelected" />
<CargoTypeModal @bind-IsOpen="isCargoTypeModalOpen" OnCargoTypeSelected="HandleCargoTypeSelected" />

@code {
    private string ActiveTab = "reserve";
    private string SelectedDate = "انتخاب تاریخ";
    private string SelectedVehicle = "انتخاب نوع خودرو";
    private string SelectedCargoType = "انتخاب نوع بار";

    private bool isDateModalOpen;
    private bool isVehicleModalOpen;
    private bool isCargoTypeModalOpen;

    private List<TabItem> _tabs = new()
    {
        new TabItem 
        { 
            Id = "new-cargo",
            Title = "ثبت بار ",
            Subtitle = "اعلان بار",
            IconUrl = "https://cdn.lordicon.com/udwhdpod.json"
        },
        new TabItem 
        { 
            Id = "reserve",
            Title = "رزرو بار",
            Subtitle = "بازارگاه بار",
            IconUrl = "https://cdn.lordicon.com/qhviklyi.json"
        },
        new TabItem 
        { 
            Id = "waybill",
            Title = "بارنامه",
            Subtitle = " حواله بار",
            IconUrl = "https://cdn.lordicon.com/puvaffet.json"
        }
    };

    private void SelectTab(string tabId)
    {
        ActiveTab = tabId;
    }

    private void OpenDateModal()
    {
        isDateModalOpen = true;
    }

    private void OpenVehicleModal()
    {
        isVehicleModalOpen = true;
    }

    private void OpenCargoTypeModal()
    {
        isCargoTypeModalOpen = true;
    }

    private void HandleDateSelected(string date)
    {
        SelectedDate = date;
    }

    private void HandleVehicleSelected(string vehicle)
    {
        SelectedVehicle = vehicle;
    }

    private void HandleCargoTypeSelected(string cargoType)
    {
        SelectedCargoType = cargoType;
    }

    private void SearchCargo()
    {
        // Implement search logic
    }

    private class TabItem
    {
        public string Id { get; set; }
        public string Title { get; set; }
        public string Subtitle { get; set; }
        public string IconUrl { get; set; }
    }
} 