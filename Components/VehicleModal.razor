@if (IsOpen)
{
    <div class="popup-modal container fixed inset-0 z-30">
        <div class="modalBg absolute inset-0 bg-black opacity-30 dark:bg-white" @onclick="OnClose"></div>
        <div class="modal relative z-10 flex h-full flex-col items-center justify-center px-6">
            <div class="w-full rounded-2xl bg-b50 p-7 dark:bg-n50">
                <div class="modal-title">
                    <p class="text-3xl font-bold dark:text-white">نوع خودرو</p>
                    <p class="modal-subtitle pt-3">خودروی مورد نیاز خود را انتخاب کنید</p>
                </div>
                <div class="flex flex-col gap-4 border-y border-dashed border-n100 py-5 dark:border-n70">
                    @foreach (var category in VehicleCategories)
                    {
                        <div class="vehicle-category">
                            <p class="text-lg font-bold mb-3 text-right">@category.Title</p>
                            <div class="flex flex-col gap-3">
                                @foreach (var vehicle in category.Vehicles)
                                {
                                    <label class="cursor-pointer">
                                        <div class="option-group flex items-center justify-between">
                                            <div class="flex items-center justify-start gap-3">
                                                <div class="flex items-center justify-center rounded-full bg-white p-2.5 text-xl text-p1 dark:bg-n0">
                                                    <i class="@vehicle.Icon"></i>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-sm font-semibold dark:text-white">@vehicle.Name</p>
                                                    <p class="option-description">@vehicle.Description</p>
                                                </div>
                                            </div>
                                            <div class="flex size-6 items-center justify-center rounded-full border border-n100 dark:border-n70">
                                                <input type="radio" name="vehicleType" value="@vehicle.Id" 
                                                       @onchange="() => SelectVehicle(vehicle.Name)"
                                                       class="size-3">
                                            </div>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="flex items-center justify-between gap-4 pt-5">
                    <button @onclick="OnClose" class="w-full rounded-xl border border-n100 bg-white py-3 text-sm font-semibold text-n400 dark:border-n70 dark:bg-n0 dark:text-n500">لغو</button>
                    <button @onclick="OnConfirm" class="w-full rounded-xl bg-p1 py-3 text-sm font-semibold text-white">تایید</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnVehicleSelected { get; set; }

    private string selectedVehicle;

    private class VehicleType
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public string Icon { get; set; }
    }

    private class VehicleCategory
    {
        public string Title { get; set; }
        public List<VehicleType> Vehicles { get; set; }
    }

    private List<VehicleCategory> VehicleCategories = new()
    {
        new VehicleCategory
        {
            Title = "کامیون‌ها",
            Vehicles = new List<VehicleType>
            {
                new() { Id = "single_truck", Name = "کامیون تک", Description = "ظرفیت حمل تا 10 تن", Icon = "ph ph-truck" },
                new() { Id = "double_truck", Name = "کامیون جفت", Description = "ظرفیت حمل تا 19 تن", Icon = "ph ph-truck" }
            }
        },
        new VehicleCategory
        {
            Title = "کشنده‌ها",
            Vehicles = new List<VehicleType>
            {
                new() { Id = "curtain_trailer", Name = "تریلی چادری", Description = "ظرفیت حمل تا 24 تن", Icon = "ph ph-truck" },
                new() { Id = "lowboy_trailer", Name = "تریلی کمرشکن", Description = "مناسب برای حمل ماشین‌آلات سنگین", Icon = "ph ph-truck" },
                new() { Id = "refrigerated_trailer", Name = "تریلی یخچال‌دار", Description = "مناسب برای حمل بار فاسدشدنی", Icon = "ph ph-truck" }
            }
        },
        new VehicleCategory
        {
            Title = "وانت‌ها",
            Vehicles = new List<VehicleType>
            {
                new() { Id = "covered_pickup", Name = "وانت مسقف", Description = "مناسب برای بارهای سبک تا 1 تن", Icon = "ph ph-van" },
                new() { Id = "open_pickup", Name = "وانت روباز", Description = "مناسب برای بارهای سبک تا 2 تن", Icon = "ph ph-van" }
            }
        }
    };

    private void SelectVehicle(string vehicle)
    {
        selectedVehicle = vehicle;
    }

    private async Task OnClose()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnConfirm()
    {
        if (!string.IsNullOrEmpty(selectedVehicle))
        {
            await OnVehicleSelected.InvokeAsync(selectedVehicle);
        }
        await OnClose();
    }
} 