@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IDialogService DialogService

<style>
    .date-scroll-container {
        height: 120px;
        overflow-y: auto;
        scroll-snap-type: y mandatory;
    }

    .date-scroll-item {
        height: 40px;
        scroll-snap-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .date-scroll-item.selected {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        font-weight: bold;
    }
</style>

<MudDialog @bind-IsVisible="IsOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h5" Class="text-center">انتخاب تاریخ</MudText>
        <MudText Typo="Typo.body2" Class="text-center mt-2">تاریخ حمل بار خود را انتخاب کنید</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Justify="Justify.SpaceBetween" Class="py-4">
            <MudItem xs="4">
                <MudPaper Class="d-flex flex-column align-center pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Primary" Size="Size.Large" />
                    <MudText Class="mt-2">سال</MudText>
                    <div class="date-scroll-container">
                        <div style="height: 40px"></div> @* Spacer for top *@
                        @foreach (var year in Years)
                        {
                            <div class="date-scroll-item @(selectedYear == year ? "selected" : "")"
                                 @onclick="@(() => selectedYear = year)">
                                @year
                            </div>
                        }
                        <div style="height: 40px"></div> @* Spacer for bottom *@
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Class="d-flex flex-column align-center pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" Size="Size.Large" />
                    <MudText Class="mt-2">ماه</MudText>
                    <div class="date-scroll-container">
                        <div style="height: 40px"></div> @* Spacer for top *@
                        @foreach (var month in Months)
                        {
                            <div class="date-scroll-item @(selectedMonth == month.FullName ? "selected" : "")"
                                 @onclick="@(() => selectedMonth = month.FullName)">
                                @month.FullName
                            </div>
                        }
                        <div style="height: 40px"></div> @* Spacer for bottom *@
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Class="d-flex flex-column align-center pa-4">
                    <MudIcon Icon="@Icons.Material.Filled.Numbers" Color="Color.Primary" Size="Size.Large" />
                    <MudText Class="mt-2">روز</MudText>
                    <div class="date-scroll-container">
                        <div style="height: 40px"></div> @* Spacer for top *@
                        @foreach (var day in Days)
                        {
                            <div class="date-scroll-item @(selectedDay == day ? "selected" : "")"
                                 @onclick="@(() => selectedDay = day)">
                                @day
                            </div>
                        }
                        <div style="height: 40px"></div> @* Spacer for bottom *@
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnClose" Variant="Variant.Outlined" Color="Color.Primary">لغو</MudButton>
        <MudButton OnClick="OnConfirm" Variant="Variant.Filled" Color="Color.Primary">تایید</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnDateSelected { get; set; }

    private string selectedYear;
    private string selectedMonth;
    private string selectedDay;

    private DialogOptions dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Medium
    };

    private List<string> Years = new() { "1402", "1403", "1404", "1405", "1406" };
    private List<PersianMonth> Months = new()
    {
        new() { FullName = "فروردین", ShortName = "فرو" },
        new() { FullName = "اردیبهشت", ShortName = "ارد" },
        new() { FullName = "خرداد", ShortName = "خرد" },
        new() { FullName = "تیر", ShortName = "تیر" },
        new() { FullName = "مرداد", ShortName = "مرد" },
        new() { FullName = "شهریور", ShortName = "شهر" },
        new() { FullName = "مهر", ShortName = "مهر" },
        new() { FullName = "آبان", ShortName = "آبا" },
        new() { FullName = "آذر", ShortName = "آذر" },
        new() { FullName = "دی", ShortName = "دی" },
        new() { FullName = "بهمن", ShortName = "بهم" },
        new() { FullName = "اسفند", ShortName = "اسف" }
    };
    private List<string> Days = Enumerable.Range(1, 31).Select(d => d.ToString()).ToList();

    private async Task OnClose()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnConfirm()
    {
        if (string.IsNullOrEmpty(selectedYear) || string.IsNullOrEmpty(selectedMonth) || string.IsNullOrEmpty(selectedDay))
        {
            await DialogService.ShowMessageBox("خطا", "لطفا تمام فیلدها را پر کنید");
            return;
        }

        string selectedDate = $"{selectedDay} - {selectedMonth} - {selectedYear}";
        await OnDateSelected.InvokeAsync(selectedDate);
        await OnClose();
    }

    private class PersianMonth
    {
        public string FullName { get; set; }
        public string ShortName { get; set; }
    }
} 