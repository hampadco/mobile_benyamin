@using MudBlazor

<link href="css/components/Navigation.css" rel="stylesheet" />

<div class="navigation-container">
    <div class="navigation-wrapper">
        <div class="navigation-inner">
            <MudLink Href="/">
                <div class="navigation-menu-bg">
                    <MudImage Src="assets/images/menu-bg.png" Alt="" Class="navigation-menu-bg-image" />
                    <div class="navigation-menu-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Medium" Class="!text-lg" />
                    </div>
                </div>
                <div class="navigation-link">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Medium" Class="text-white" />
                    <span class="navigation-dot"></span>
                </div>
            </MudLink>
            <MudLink Href="/" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Medium" Class="text-white" />
            </MudLink>
            <MudLink Href="/" Class="navigation-support"> 
                <MudText Class="text-white">پشتیبانی</MudText>
            </MudLink>
            <MudLink Href="/" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Wallet" Size="Size.Medium" Class="text-white" />
            </MudLink>
            <MudLink Href="/" Class="text-2xl">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Class="text-white" />
            </MudLink>
        </div>
    </div>
</div>

