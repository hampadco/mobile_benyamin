@using MudBlazor

<MudContainer Class="homeTab">
    <MudGrid Class="tab-button pt-10" Spacing="2" Justify="Justify.SpaceBetween">
        @foreach (var tab in _tabs)
        {
            <MudItem xs="12" sm="4" Style="min-width: 0;">
                <MudPaper Elevation="0" Class="home-tab-item relative cursor-pointer rounded-3xl p-1 h-100" @onclick="() => SelectTab(tab.Id)">
                    <div class="absolute bottom-0 left-0 right-0 flex items-center justify-center">
                        <div class="activeBar h-0.5 w-16 rounded-t-full @(ActiveTab == tab.Id ? "bg-p1" : "bg-b50 dark:bg-n50")"></div>
                    </div>
                    <MudPaper Elevation="0" Class="b flex w-full items-center justify-center rounded-3xl bg-b50 py-4 dark:bg-n50">
                        <div class="service-icon" style="width: 48px; height: 48px;">
                            <lord-icon
                                src="@tab.IconUrl"
                                trigger="hover"
                                colors="primary:#2563eb"
                                state="hover"
                                style="width:100%;height:100%">
                            </lord-icon>
                        </div>
                    </MudPaper>
                    <MudText Align="Align.Center" Class="p-3">
                        <MudText Typo="Typo.h6" Class="tab-item-text font-bold dark:text-white">@tab.Title</MudText>
                        <MudText Typo="Typo.body2" Class="text-n400 dark:text-n500">@tab.Subtitle</MudText>
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @if (ActiveTab == "reserve")
    {
        <MudPaper Elevation="0" Class="hotelTab mt-7 rounded-3xl p-5">
            <MudStack Spacing="4">
                <MudStack AlignItems="AlignItems.Center" Class="pb-4 border-b border-dashed border-n100 dark:border-n70">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h5" Color="Color.Primary">جستجوی بارها</MudText>
                        <lord-icon
                            src="https://cdn.lordicon.com/msoeawqm.json"
                            trigger="hover"
                            colors="primary:#2563eb"
                            style="width:32px;height:32px">
                        </lord-icon>
                    </MudStack>
                </MudStack>

                <MudStack Class="pt-4" Spacing="4">
                    <div class="animationOne content" id="flight">
                        <MudStack Spacing="4">
                            <MudPaper Elevation="0" Class="w-full">
                                <MudButton Variant="Variant.Outlined" FullWidth="true" Class="rounded-xl p-3.5">
                                    <MudText Class="text-n400">انتخاب مبدا</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudPaper Elevation="0" Class="w-full">
                                <MudButton Variant="Variant.Outlined" FullWidth="true" Class="rounded-xl p-3.5">
                                    <MudText Class="text-n400">انتخاب مقصد</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudPaper Elevation="0" Class="w-full">
                                <MudText Class="pb-2" Typo="Typo.subtitle2">تاریخ حمل</MudText>
                                <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenDateModal" Class="rounded-xl p-3.5">
                                    <MudText Class="!text-[30px] text-n500">@SelectedDate</MudText>
                                </MudButton>
                            </MudPaper>

                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudText Class="pb-2" Typo="Typo.subtitle2">نوع خودرو</MudText>
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenVehicleModal" Class="rounded-xl p-3.5">
                                        <MudText Class="text-n400">@SelectedVehicle</MudText>
                                    </MudButton>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudText Class="pb-2" Typo="Typo.subtitle2">نوع بار</MudText>
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="OpenCargoTypeModal" Class="rounded-xl p-3.5">
                                        <MudText Class="text-n400">@SelectedCargoType</MudText>
                                    </MudButton>
                                </MudItem>
                            </MudGrid>

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SearchCargo" Class="rounded-xl p-3">
                                جستجوی بار
                            </MudButton>
                        </MudStack>
                    </div>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

<DateModal @bind-IsOpen="isDateModalOpen" OnDateSelected="HandleDateSelected" />
<VehicleModal @bind-IsOpen="isVehicleModalOpen" OnVehicleSelected="HandleVehicleSelected" />
<CargoTypeModal @bind-IsOpen="isCargoTypeModalOpen" OnCargoTypeSelected="HandleCargoTypeSelected" />

@code {
    private string ActiveTab = "reserve";
    private string SelectedDate = "انتخاب تاریخ";
    private string SelectedVehicle = "انتخاب نوع خودرو";
    private string SelectedCargoType = "انتخاب نوع بار";

    private bool isDateModalOpen;
    private bool isVehicleModalOpen;
    private bool isCargoTypeModalOpen;

    private List<TabItem> _tabs = new()
    {
        new TabItem 
        { 
            Id = "new-cargo",
            Title = "ثبت بار ",
            Subtitle = "ارسال بار",
            IconUrl = "https://cdn.lordicon.com/udwhdpod.json"
        },
        new TabItem 
        { 
            Id = "reserve",
            Title = "رزرو بار",
            Subtitle = "رزرو آنلاین",
            IconUrl = "https://cdn.lordicon.com/qhviklyi.json"
        },
        new TabItem 
        { 
            Id = "waybill",
            Title = "بارنامه",
            Subtitle = " اسناد",
            IconUrl = "https://cdn.lordicon.com/puvaffet.json"
        }
    };

    private void SelectTab(string tabId)
    {
        ActiveTab = tabId;
    }

    private void OpenDateModal()
    {
        isDateModalOpen = true;
    }

    private void OpenVehicleModal()
    {
        isVehicleModalOpen = true;
    }

    private void OpenCargoTypeModal()
    {
        isCargoTypeModalOpen = true;
    }

    private void HandleDateSelected(string date)
    {
        SelectedDate = date;
    }

    private void HandleVehicleSelected(string vehicle)
    {
        SelectedVehicle = vehicle;
    }

    private void HandleCargoTypeSelected(string cargoType)
    {
        SelectedCargoType = cargoType;
    }

    private void SearchCargo()
    {
        // Implement search logic
    }

    private class TabItem
    {
        public string Id { get; set; }
        public string Title { get; set; }
        public string Subtitle { get; set; }
        public string IconUrl { get; set; }
    }
} 