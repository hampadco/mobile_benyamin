@using MudBlazor

@if (!ShowRoleSelection)
{
       <MudPaper Elevation="0" Class="auth-requirement-container waybill-auth-paper mt-7 shadow-lg hover:shadow-xl transition-shadow duration-300" style="margin: 3px;padding-bottom:100pxpx;border-radius: 25px;">

        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="relative">
            <div class="background-icon">
                <MudImage Src="/assets/images/sadi/1.png" Alt="background" Style="width:300px;height:300px;opacity:0.15" ObjectFit="ObjectFit.Cover" />
            </div>
            <div class="front-icon">
                <lord-icon
                    src="https://cdn.lordicon.com/egiwmiit.json"
                    trigger="loop"
                    delay="2000"
                    colors="primary:#2563eb,secondary:#2563eb"
                    style="width:80px;height:80px">
                </lord-icon>
            </div>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="text-center">اطلاعات کاربر تایید شده</MudText>
            
            <MudPaper Elevation="0" Class="w-full max-w-sm">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg bg-surface">
                    <MudStack Spacing="0">
                        <MudStack Row="true" Class="py-2 px-2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="ml-2">نام:</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="mr-auto">محمد</MudText>
                        </MudStack>
                        
                        <MudDivider />
                        
                        <MudStack Row="true" Class="py-2 px-2">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="ml-2">نام خانوادگی:</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="mr-auto">محمدی</MudText>
                        </MudStack>
                        
                        <MudDivider />
                        
                        <MudStack Row="true" Class="py-2 px-2">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="ml-2">کد ملی:</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight: 600;" Class="mr-auto">@NationalId</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
                
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Error" 
                        Size="Size.Large"
                        OnClick="@(() => OnBack.InvokeAsync())"
                        Class="py-3 rounded-lg"
                        Style="width: 48%;">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" />
                            <MudText Class="text-lg font-medium">برگشت</MudText>
                        </MudStack>
                    </MudButton>
                    
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Success" 
                        Size="Size.Large"
                        OnClick="HandleContinue"
                        Class="py-3 rounded-lg"
                        Style="width: 48%;">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" />
                            <MudText Class="text-lg font-medium">ادامه</MudText>
                        </MudStack>
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudPaper>
}
else
{
    <RoleSelection OnBack="@(() => ShowRoleSelection = false)" />
}

@code {
    [Parameter]
    public string NationalId { get; set; }
    
    [Parameter]
    public EventCallback OnBack { get; set; }
    
    private bool ShowRoleSelection { get; set; } = false;

    private void HandleContinue()
    {
        ShowRoleSelection = true;
    }
} 