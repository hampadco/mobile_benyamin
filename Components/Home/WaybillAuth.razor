@using MudBlazor

<style>
    .waybill-auth-paper {
        border-radius: 20px !important;
        overflow: hidden !important;
    }

    .waybill-auth-paper ::deep .mud-paper {
        border-radius: 20px !important;
    }

    ::deep .mud-paper {
        border-radius: 20px !important;
    }
</style>

@if (!ShowVerification)
{
    <MudPaper Elevation="0" Class="auth-requirement-container waybill-auth-paper mt-7 shadow-lg hover:shadow-xl transition-shadow duration-300" style="margin: 3px;padding-bottom:100pxpx;border-radius: 25px;">
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="relative">
            <div class="background-icon">
                <MudImage Src="/assets/images/sadi/3.png" Alt="background" Style="width:300px;height:300px;opacity:0.15" ObjectFit="ObjectFit.Cover" />
            </div>
            <div class="front-icon">
                <lord-icon
                    src="https://cdn.lordicon.com/qhviklyi.json"
                    trigger="loop"
                    delay="2000"
                    colors="primary:#2563eb,secondary:#2563eb"
                    style="width:100px;height:100px">
                </lord-icon>
            </div>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="text-center"> ثبت بارنامه نیاز به احراز هویت دارید</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="auth-button px-8 py-3 rounded-lg mt-1" OnClick="@(() => ShowVerification = true)">
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                 
                    <MudText Class="text-lg font-medium">شروع احراز هویت</MudText>
                </MudStack>
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <NationalIdVerification />
}

@code {
    private bool ShowVerification { get; set; } = false;
} 