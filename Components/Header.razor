@using MudBlazor

<div class="relative z-10 px-6 pb-8 pt-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Row="true" Spacing="5" AlignItems="AlignItems.Center">
            <MudAvatar Image="assets/images/user.png" Size="Size.Large" Class="size-14" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Color="Color.Surface" Class="text-xl font-semibold text-white">به سامانه شوفر خوش آمدید</MudText>
                <MudStack Spacing="0" Class="-mt-1">
                    <MudText Color="Color.Surface" Style="opacity: 0.9" Class="text-lg text-white">رحیم قاسمی</MudText>
                    <MudText Color="Color.Surface" Style="opacity: 0.8" Class="text-sm -mt-1 text-white">صاحب بار</MudText>
                </MudStack>
            </MudStack>
        </MudStack>
        
        <MudIconButton
            Href="notification.html"
            Icon="@Icons.Material.Filled.Notifications"
            Color="Color.Surface"
            Size="Size.Large"
            Class="border border-white size-12 text-white" />
    </MudStack>
</div>

