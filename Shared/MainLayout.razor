@inherits LayoutComponentBase
@using MudBlazor

<link href="css/components/MainLayout.css" rel="stylesheet" />
  <style>
        /* MudBlazor padding overrides */
        .pl-6,
        .px-6 {
            padding-left: 2px !important;
        }

        .pr-6,
        .px-6 {
            padding-right: 2px !important;
        }
    </style>
<MudLayout Style="padding: 0; background: none;">
    <MudMainContent Style="padding: 0;">
        <div class="main-container">
            <MudImage Src="assets/images/top-bg-shape2.png" Alt="" Class="background-shape" />
            <div class="content-wrapper">
                @Body
            </div>
        </div>
    </MudMainContent>
</MudLayout>

