
<style>
    .bottom-center {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
    }


    .mud-drawer.mud-drawer-temporary.mud-drawer-pos-bottom {
        left: 50%;
        transform: translateX(-50%);
        top: auto;
        width: 380px;
        bottom: 30px;
        
    }

        .mud-drawer.mud-drawer-temporary.mud-drawer-pos-bottom.mud-drawer--open {
            bottom: 70px;
        }

    .mud-divider {
        border-color: #808080;
        border-width: 2px;
        border-style: dotted none none none;
    }
</style>
<MudPaper Class="rounded-pill bottom-center pa-3" Width="200px">
    <MudStack Row="true">
        <MudItem><MudLink Underline="Underline.None" OnClick="OpenSortDrawer"><MudText Inline="true"><MudIcon Color="Color.Primary" Icon="@Icons.Material.Outlined.Sort" Size="Size.Medium"></MudIcon>مرتب سازی</MudText></MudLink></MudItem>
        <MudSpacer />
        <MudItem><MudLink Underline="Underline.None" OnClick="OpenFilterDrawer"><MudText><MudIcon Color="Color.Primary" Icon="@Icons.Material.Outlined.EditNote" Size="Size.Medium"></MudIcon>فیلتر</MudText></MudLink></MudItem>
    </MudStack>

</MudPaper>

<MudDrawer Class="rounded-xl" @bind-Open="@_open" Anchor="Anchor.Bottom" Elevation="1" Variant="@DrawerVariant.Temporary">


    <MudPaper Class="rounded-xl pa-4" Style="background-color: #efebff;">
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="OpenSortDrawer" aria-label="delete" />
        <MudText Align="Align.Center" Class="pb-3" Color="Color.Inherit">مرتب سازی</MudText>
        <MudItem Class="rounded-xl" Style="background-color:white;">
            <MudRadioGroup T="int">
                <MudList Style="width:100%" T="string">
                    <MudListItem>
                        <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                            <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                                <MudText>ارزانترین</MudText>
                            </MudItem>
                            <MudRadio Value="1" Color="Color.Primary"></MudRadio>
                        </MudItem>
                    </MudListItem>
                    <MudDivider />
                    <MudListItem>
                        <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                            <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                                <MudText>گرانترین</MudText>
                            </MudItem>
                            <MudRadio Value="2" Color="Color.Primary"></MudRadio>
                        </MudItem>
                    </MudListItem>
                    <MudDivider />
                    <MudListItem>
                        <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                            <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                                <MudText>جدیدترین</MudText>
                            </MudItem>
                            <MudRadio Value="3" Color="Color.Primary"></MudRadio>
                        </MudItem>
                    </MudListItem>
                    <MudDivider />
                    <MudListItem>
                        <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                            <MudItem Class="d-flex align-content-center flex-wrap flex-grow-1">
                                <MudText>ارزانترین</MudText>
                            </MudItem>
                            <MudRadio Value="4" Color="Color.Primary"></MudRadio>
                        </MudItem>
                    </MudListItem>
                </MudList>
            </MudRadioGroup>
        </MudItem>
    </MudPaper>

</MudDrawer>

@code {
    private string _drawerClass = "";
    private bool _open = false;
    private bool _open2 = false;
    private void OpenSortDrawer()
    {
        _drawerClass = _drawerClass == "mud-drawer-fixeddd" ? "" : "mud-drawer-fixeddd";
        _open = !_open;
    }
    private void OpenFilterDrawer()
    {
        _drawerClass = _drawerClass == "mud-drawer-fixeddd" ? "" : "mud-drawer-fixeddd";
        _open2 = !_open2;
    }



}